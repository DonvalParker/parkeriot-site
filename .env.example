# Formspree form ID — create a form at https://formspree.io and set the
# notification email to info@parkeriot.uk. Copy the ID from your form URL:
# https://formspree.io/f/YOUR_FORM_ID
FORMSPREE_FORM_ID=

# Set to "true" in Vercel to redirect all visitors to /maintenance.
# Remove or set to "false" when the site is ready to go live.
MAINTENANCE_MODE=false

# Optional: visit https://parkeriot.uk?bypass=YOUR_SECRET to preview the site
# while maintenance mode is on. Pick a long random string.
MAINTENANCE_BYPASS_SECRET=
